{
	"name": "@yaiuse/echo",
	"version": "0.6.2",
	"license": "MIT",
	"author": {
		"name": "YAIuse",
		"email": "help.yai.team@gmail.com",
		"url": "https://github.com/YAIuse"
	},
	"contributors": [
		"Zoltroa (https://github.com/zoltroa)"
	],
	"description": "An HTTP client built on fetch, offering an Axios-like experience with support for interceptors.",
	"repository": {
		"type": "git",
		"url": "https://github.com/YAIuse/Echo"
	},
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"bundle:cjs": "esbuild dist/index.js --bundle --minify --platform=neutral --format=cjs --outfile=dist/index.cjs",
		"test:unit": "jest --coverage",
		"prebuild": "rimraf dist",
		"build": "tsc --project tsconfig.build.json && bun run bundle:cjs && cp dist/index.d.ts dist/index.d.cts",
		"postbuild": "bun run test:unit",
		"npm:check": "npm pack --dry-run",
		"npm:publish": "bun run build && npm publish --access public",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "6.0.2",
		"@types/jest": "^30.0.0",
		"esbuild": "^0.28.2",
		"jest": "^30.4.2",
		"jest-fetch-mock": "^4.2.0",
		"prettier": "3.9.6",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.12",
		"typescript": "^6.0.3"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"jest": {
		"moduleFileExtensions": [
			"js",
			"ts"
		],
		"testMatch": [
			"<rootDir>/tests/**/*.(spec|test).ts"
		],
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"src/**/*.(t|j)s",
			"!**/*.(spec|test).ts",
			"!**/*.d.ts",
			"!**/*.index.(t|j)s"
		],
		"coverageDirectory": "coverage",
		"testEnvironment": "node"
	},
	"keywords": [
		"echo",
		"axios",
		"node",
		"http",
		"https",
		"fetch",
		"network",
		"browser",
		"request",
		"promise",
		"rest",
		"api",
		"client"
	]
}
